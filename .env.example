# ---------------------------------------------------------------------------
# Sales-CRM environment configuration
# Copy to `.env` and fill in what you have. EVERYTHING is optional:
# the app boots in a clearly-labelled "local / simulated" mode when a
# credential is missing instead of pretending an integration is live.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the storefront (used for canonical URLs, sitemap, emails)
PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed to call the API cross-origin (e.g. a Vercel
# frontend). EMPTY = same-origin only (recommended single-deployment setup:
# the Express server serves the built SPA, the frontend calls relative /api).
CORS_ORIGINS=

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded SQLite runtime (./data/app.sqlite).
# For production (Supabase free plan):
#   Dashboard → Project Settings → Database → Connection string → URI.
#   * Direct connection (port 5432) is recommended for a single always-on service.
#   * If you hit connection limits, use the SESSION-mode pooler (port 5432).
#     Transaction-mode pooler also works (the app's RLS identity is tx-local).
#   The password must be URL-encoded in the connection string.
DATABASE_URL=
SQLITE_PATH=./data/app.sqlite
# auto = SSL everywhere except localhost | require | disable
DATABASE_SSL_MODE=auto
# Keep the pool small on free tiers (Supabase free: limited direct connections).
PG_POOL_MAX=5
# Run migrations + seed at server boot. Set false only when the app connects with
# a non-DDL role (then run `DATABASE_URL=... npm run db:migrate` separately).
DB_MIGRATE_ON_BOOT=true
# Copy existing local SQLite data into Postgres (never touches the source):
#   DATABASE_URL=postgres://... npm run db:copy-to-pg [--dry-run|--include-users|--include-orders|--include-data]

# --- Auth / sessions -------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
# First admin account, created by `npm run db:seed` if no admin exists.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!
# Store clock tolerance / session lifetime (hours)
SESSION_TTL_HOURS=720

# --- Payments (Razorpay) ---------------------------------------------------
# When unset, checkout runs in SIMULATED mode (clearly labelled in the UI,
# no real charge). Server-side signature verification is active in live mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email -----------------------------------------------------------------
# console | resend. `console` writes to server log + email_log table (dev only).
EMAIL_PROVIDER=console
EMAIL_FROM="Ojas Store <orders@example.com>"
RESEND_API_KEY=

# --- Suppliers -------------------------------------------------------------
# Enable the background scheduler (stock/price/tracking/fulfillment retries).
SUPPLIER_SCHEDULER_ENABLED=true
SUPPLIER_SCHEDULER_INTERVAL_MS=60000
# Credentials for real supplier adapters are read from env ONLY, e.g.
# SUPPLIER_HTTP_BEARER_TOKEN=

# --- Analytics -------------------------------------------------------------
# First-party, cookieless analytics is always on. External pixels are OFF
# unless a key is provided AND the visitor consents.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# --- Store -----------------------------------------------------------------
STORE_CURRENCY=INR
