# ---------------------------------------------------------------------------
# Sales-CRM environment configuration
# Copy to `.env` and fill in what you have. EVERYTHING is optional:
# the app boots in a clearly-labelled "local / simulated" mode when a
# credential is missing instead of pretending an integration is live.
# ---------------------------------------------------------------------------

# --- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Public origin of the storefront (used for canonical URLs, sitemap, emails)
PUBLIC_URL=http://localhost:4000

# --- Database --------------------------------------------------------------
# Leave DATABASE_URL empty to use the embedded SQLite runtime (./data/app.sqlite).
# Set a postgres:// URL (or your Supabase pooled connection string) for production.
DATABASE_URL=
SQLITE_PATH=./data/app.sqlite

# --- Auth / sessions -------------------------------------------------------
# REQUIRED in production. Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-in-production
# First admin account, created by `npm run db:seed` if no admin exists.
ADMIN_EMAIL=owner@example.com
ADMIN_PASSWORD=ChangeMe123!
# Store clock tolerance / session lifetime (hours)
SESSION_TTL_HOURS=720

# --- Payments (Razorpay) ---------------------------------------------------
# When unset, checkout runs in SIMULATED mode (clearly labelled in the UI,
# no real charge). Server-side signature verification is active in live mode.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Email -----------------------------------------------------------------
# console | resend. `console` writes to server log + email_log table (dev only).
EMAIL_PROVIDER=console
EMAIL_FROM="Ojas Store <orders@example.com>"
RESEND_API_KEY=

# --- Suppliers -------------------------------------------------------------
# Enable the background scheduler (stock/price/tracking/fulfillment retries).
SUPPLIER_SCHEDULER_ENABLED=true
SUPPLIER_SCHEDULER_INTERVAL_MS=60000
# Credentials for real supplier adapters are read from env ONLY, e.g.
# SUPPLIER_HTTP_BEARER_TOKEN=

# --- Analytics -------------------------------------------------------------
# First-party, cookieless analytics is always on. External pixels are OFF
# unless a key is provided AND the visitor consents.
VITE_GA4_MEASUREMENT_ID=
VITE_META_PIXEL_ID=

# --- Store -----------------------------------------------------------------
STORE_CURRENCY=INR
